+import { Component, inject, OnInit } from '@angular/core';
+import { collection, getDocs } from 'firebase/firestore';
+import { FIREBASE_FIRESTORE } from '../../core/firebase/firebase.tokens';
+
+@Component({
+  selector: 'app-booking-list',
+  standalone: true,
+  template: `<ul>@for (b of bookings; track b.id) { <li>{{ b.id }}</li> }</ul>`,
+})
+export class BookingListComponent implements OnInit {
+  private firestore = inject(FIREBASE_FIRESTORE);
+  bookings: { id: string }[] = [];
+
+  async ngOnInit() {
+    const snap = await getDocs(collection(this.firestore, 'bookings'));
+    this.bookings = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
+  }
+}
