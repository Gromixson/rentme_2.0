{
  "name": "rentme",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "setup:firestore": "node scripts/enable-firestore.mjs",
    "setup:appengine": "node scripts/setup-appengine.mjs",
    "setup:auth": "firebase deploy --only auth",
    "dev:api": "firebase emulators:start --only functions",
    "dev:emulators": "firebase emulators:start --only functions",
    "emulators:stop": "powershell -NoProfile -File scripts/stop-emulators.ps1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch --browsers=ChromeHeadless",
    "hooks:install": "lefthook install",
    "hooks:verify": "node scripts/hooks/verify-hooks.mjs",
    "functions:build": "npm run build --prefix functions",
    "functions:test": "npm run test --prefix functions",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "emulators": "firebase emulators:start --import=./.firebase-emulator-data --export-on-exit",
    "emulators:exec": "firebase emulators:exec"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/animations": "^21.2.13",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeng/themes": "^21.0.4",
    "firebase": "^12.13.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@ast-grep/cli": "^0.44.1",
    "@playwright/test": "^1.61.1",
    "@types/jasmine": "^5.1.7",
    "google-auth-library": "^10.9.0",
    "jasmine-core": "^5.6.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "lefthook": "^1.13.6",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "zone.js": "^0.15.0"
  }
}
